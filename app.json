{
  "id": "eu.edwinsmulders.salus",
  "version": "0.2.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Salus Smart Home"
  },
  "category": "climate",
  "brandColor": "#00428a",
  "icon": "/assets/icon.png",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "contributors": {
    "developers": [
      {
        "name": "Edwin Smulders"
      },
      {
        "name": "Peterka35"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/Dutchy-/salus-homey/issues"
  },
  "description": {
    "en": "Smarter comfort in every room."
  },
  "tags": {
    "en": [
      "salus",
      "quantum",
      "thermostat",
      "climate"
    ]
  },
  "support": "mailto:edwin@edwinsmulders.eu",
  "homepage": "https://github.com/Dutchy-/salus-homey",
  "source": "https://github.com/Dutchy-/salus-homey",
  "author": {
    "name": "Edwin Smulders",
    "email": "edwin@edwinsmulders.eu"
  },
  "capabilities": {
    "salus_heating_active": {
      "type": "boolean",
      "title": {
        "en": "Heating"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/heating.svg",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Heating started"
      },
      "insightsTitleFalse": {
        "en": "Heating stopped"
      }
    },
    "salus_hold_mode": {
      "type": "enum",
      "title": {
        "en": "Preset"
      },
      "values": [
        {
          "id": "schedule",
          "title": {
            "en": "Follow schedule"
          }
        },
        {
          "id": "hold",
          "title": {
            "en": "Permanent hold"
          }
        },
        {
          "id": "standby",
          "title": {
            "en": "Standby"
          }
        }
      ],
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/schedule.svg"
    },
    "salus_cooling_active": {
      "type": "boolean",
      "title": {
        "en": "Cooling"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/cooling.svg",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Cooling started"
      },
      "insightsTitleFalse": {
        "en": "Cooling stopped"
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "heating_started",
        "title": {
          "en": "Heating started"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      },
      {
        "id": "heating_stopped",
        "title": {
          "en": "Heating stopped"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      },
      {
        "id": "cooling_started",
        "title": {
          "en": "Cooling started"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      },
      {
        "id": "cooling_stopped",
        "title": {
          "en": "Cooling stopped"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "resume_schedule",
        "title": {
          "en": "Resume schedule"
        },
        "hint": {
          "en": "Return the thermostat to its own programmed schedule, ending a manual hold or standby."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_heating",
        "title": {
          "en": "Is !{{heating|not heating}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      },
      {
        "id": "is_cooling",
        "title": {
          "en": "Is !{{cooling|not cooling}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=salus_sensor"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "salus_sensor",
      "name": {
        "en": "Quantum Thermostat"
      },
      "description": {
        "en": "Salus Quantum Thermostat (SQ610RF/SQ610) with temperature and humidity."
      },
      "class": "thermostat",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "onoff",
        "measure_temperature",
        "measure_humidity",
        "target_temperature",
        "thermostat_mode",
        "salus_hold_mode",
        "salus_heating_active",
        "salus_cooling_active"
      ],
      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 5,
          "max": 45,
          "step": 0.5
        },
        "thermostat_mode": {
          "title": {
            "en": "Operating mode"
          }
        }
      },
      "images": {
        "small": "/drivers/salus_sensor/assets/images/small.png",
        "large": "/drivers/salus_sensor/assets/images/large.png",
        "xlarge": "/drivers/salus_sensor/assets/images/xlarge.png"
      },
      "settings": [
        {
          "id": "device_family",
          "type": "label",
          "label": {
            "en": "Device Family"
          },
          "value": "Quantum Thermostat (SQ610RF/SQ610)"
        },
        {
          "id": "device_model",
          "type": "text",
          "label": {
            "en": "Detected Model"
          }
        },
        {
          "id": "device_code",
          "type": "text",
          "label": {
            "en": "Salus Device Code"
          }
        },
        {
          "id": "email",
          "type": "label",
          "label": {
            "en": "Salus Account Email"
          },
          "value": "Stored securely during pairing"
        }
      ],
      "pair": [
        {
          "id": "loading",
          "template": "loading"
        },
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Sign in to Salus Cloud"
            },
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "name@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Sign in to Salus Cloud"
            },
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "name@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        }
      ]
    },
    {
      "id": "salus_plug",
      "name": {
        "en": "Smart Plug"
      },
      "description": {
        "en": "Salus SPE600 smart plug with power metering."
      },
      "class": "socket",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "onoff"
      ],
      "images": {
        "small": "/drivers/salus_plug/assets/images/small.png",
        "large": "/drivers/salus_plug/assets/images/large.png",
        "xlarge": "/drivers/salus_plug/assets/images/xlarge.png"
      },
      "settings": [
        {
          "id": "device_model",
          "type": "text",
          "label": {
            "en": "Detected Model"
          }
        },
        {
          "id": "device_code",
          "type": "text",
          "label": {
            "en": "Salus Device Code"
          }
        },
        {
          "id": "email",
          "type": "label",
          "label": {
            "en": "Salus Account Email"
          },
          "value": "Stored securely during pairing"
        }
      ],
      "pair": [
        {
          "id": "loading",
          "template": "loading"
        },
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Sign in to Salus Cloud"
            },
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "name@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Sign in to Salus Cloud"
            },
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "name@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        }
      ]
    }
  ]
}
